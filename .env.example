# ══════════════════════════════════════════════════════════════════════
#  MarketMind-Pro Environment Configuration Template
#  Copy to .env and fill in your values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://marketmind:password@localhost:5432/marketmind
DATABASE_URL_SYNC=postgresql+psycopg2://marketmind:password@localhost:5432/marketmind

# ── Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_channel_id
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty for open mode (use this first run to discover your own ID).
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# ── External APIs ────────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key
EXCHANGERATE_API_KEY=your_exchangerate_api_key
# Optional free Finnhub key (finnhub.io) — quote / company-news / earnings.
# Empty → the Finnhub provider is skipped (fail-open).
FINNHUB_API_KEY=

# ── Market-data providers (src/data) ─────────────────────────────────
# Comma-separated priority list for the provider abstraction. The composite
# tries each in order and fails over. Options: yfinance, stooq, edgar,
# finnhub, alphavantage. Default: yfinance only.
DATA_PROVIDER_PRIORITY=yfinance
# Independent source(s) used to cross-check the yfinance close (empty =
# disabled). e.g. DATA_CROSSCHECK_PROVIDERS=stooq
DATA_CROSSCHECK_PROVIDERS=
# Flag a price when providers disagree by more than this fraction (0.02 = 2%).
DATA_CONSENSUS_TOLERANCE_PCT=0.02
# Flag a live quote older than this many seconds.
DATA_QUALITY_MAX_AGE_SECONDS=3600
# SEC EDGAR fair-access User-Agent (descriptive, with a contact). No key.
SEC_EDGAR_USER_AGENT=MarketMind-Pro/1.0 (research; contact via admin)

# ── GitHub Pages ─────────────────────────────────────────────────────
GITHUB_PAGES_REPO=maaoor6/MarketMind-Pro
GITHUB_TOKEN=your_github_personal_access_token

# ── MCP Servers ──────────────────────────────────────────────────────
GOOGLE_SEARCH_MCP_PORT=8001
SQL_MCP_PORT=8002
GOOGLE_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id

# ── App Settings ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE_US=America/New_York
TIMEZONE_TASE=Asia/Jerusalem

# ── Cache TTLs (seconds) ──────────────────────────────────────────────
QUOTE_CACHE_TTL=60
NEWS_CACHE_TTL=900

# ── StockArena Paper Trading (simulated money) ───────────────────────
# API token from the StockArena dashboard — SECRET, required for trading.
# Rotate it via "Rotate API token" if it is ever exposed.
STOCK_ARENA_TOKEN=
STOCK_ARENA_BASE_URL=https://chaiware.org/stock_arena
STOCK_ARENA_BOT_ID=2
STOCK_ARENA_USER_ID=2

# ── Autonomous Trading Agent ─────────────────────────────────────────
# Master kill-switch. The agent also honors the Redis flag set by /trading on|off.
TRADING_ENABLED=false
TRADING_EXTENDED_HOURS=true
TRADING_INTERVAL_SECONDS=300
# Dynamic universe: the agent scans market screeners (gainers / most active /
# losers) and picks its own stocks each cycle. Set false to trade only the
# fixed TRADING_WATCHLIST below.
TRADING_DYNAMIC_UNIVERSE=true
# Max tickers evaluated per cycle (held positions + SPY always included).
TRADING_UNIVERSE_SIZE=20
# Candidate quality filters: no penny stocks, liquid, large-cap.
TRADING_MIN_PRICE=5.0
TRADING_MIN_AVG_VOLUME=1000000
TRADING_MIN_MARKET_CAP=2000000000
# Fallback tickers — used if the market scan fails or dynamic mode is off.
TRADING_WATCHLIST=AAPL,MSFT,NVDA,GOOGL,META,SPY,QQQ,TSLA,AMZN,AMD,NFLX,JPM,XOM,UNH,COST

# ── Trading Risk Thresholds ──────────────────────────────────────────
MAX_POSITION_PCT=0.20
MAX_OPEN_POSITIONS=5
# Minimum order size — keeps the $-per-trade commission below MAX_COMMISSION_PCT.
MIN_TRADE_NOTIONAL=500
# Broker commission in $ per buy/sell order (round trip = 2x).
TRADE_COMMISSION=2.5
MAX_COMMISSION_PCT=0.01
CASH_RESERVE_PCT=0.05
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
TRAIL_STOP_PCT=0.04
MAX_DAILY_LOSS_PCT=0.03
TICKER_COOLDOWN_MINUTES=30
MIN_CONFIDENCE=0.55
# Anti-churn: strategy SELLs are ignored while a position is younger than
# this, or below the confidence gate (protective exits are exempt).
MIN_HOLDING_HOURS=72
SELL_CONFIDENCE_GATE=0.6
# Learning: weight = 1 + WEIGHT_SENSITIVITY x avg_signal_return; a strategy
# with a NEGATIVE average is disabled (weight 0) until it recovers.
WEIGHT_SENSITIVITY=50
# Volatility-aware sizing: positions in stocks whose annualized 20d vol
# exceeds this target are shrunk proportionally (budget x target/vol).
TARGET_POSITION_VOL=0.30
# Share of the universe reserved for the stable watchlist (rest = screeners).
UNIVERSE_QUALITY_RATIO=0.5
# Drawdown brake: below this drawdown from the portfolio's all-time high,
# every new buy budget is multiplied by the size factor.
DRAWDOWN_BRAKE_PCT=0.15
DRAWDOWN_SIZE_FACTOR=0.5
EXTENDED_HOURS_SIZE_FACTOR=0.5
EXTENDED_HOURS_MIN_CONFIDENCE=0.7
# ATR equal-dollar-at-risk sizing: cap a position so an adverse
# ATR_STOP_MULTIPLE x ATR move risks at most POSITION_RISK_PCT of the portfolio.
ATR_SIZING_ENABLED=true
ATR_STOP_MULTIPLE=2.0
POSITION_RISK_PCT=0.01
# Cross-agent guard: combined exposure to any one sector is capped here.
MAX_SECTOR_EXPOSURE_PCT=0.40

# ── Macro / Market-Timing Gate (Phase 2 — strictly zero paid-API cost) ─
# Hard on/off gate deciding whether it's a good time to trade at all, from
# quantitative macro data + an event blackout calendar + LOCAL NLP sentiment.
# Disabled by default (same fail-safe posture as TRADING_ENABLED); when off,
# the Orchestrator falls back to the legacy SPY/VIX regime dampener.
MACRO_GATE_ENABLED=false
# Free FRED API key (https://fred.stlouisfed.org) for yield curve + Fed net
# liquidity. Empty → those inputs fail open (neutral).
FRED_API_KEY=
# Local sentiment overlay: VADER always; FinBERT only if transformers+torch
# are installed (optional, ~GB — not in the base image). Never a paid LLM API.
SENTIMENT_LOCAL_ENABLED=true
# Anti-whipsaw hysteresis: gate flips OFF instantly but returns ON only after
# this many consecutive stable cycles.
MACRO_HYSTERESIS_CYCLES=3
# Reduce/halt new entries within this many hours of an FOMC/CPI/NFP event.
MACRO_BLACKOUT_HOURS=12
MACRO_BLACKOUT_SIZE_MULT=0.5

# ── Per-Agent Circuit Breaker (Phase 4) ──────────────────────────────
# Freeze a single thematic agent for N days if its holdings draw down past
# the limit — the other agents keep trading.
AGENT_BREAKER_DD_PCT=0.20
AGENT_BREAKER_FREEZE_DAYS=5

# ── Backtesting (offline, local, free — no API keys needed) ─────────
# Weight seeds produced by `python -m src.backtest --export-weights`;
# the live allocator uses them as cold-start priors (clamped ±20%).
BACKTEST_WEIGHTS_PATH=data/backtest_weights.json
